# Google API Credentials (for Google Drive & Google Sheets access)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# Google Drive Folders & Registry Sheets
DRIVE_FOLDER_ID=your_drive_folder_id_here
DRIVE_QUARANTINE_FOLDER_ID=your_drive_quarantine_folder_id_here
DRIVE_DUPLICATES_FOLDER_ID=your_drive_duplicates_folder_id_here
SHEET_ID=your_google_sheet_id_here


# Email Notifications via Resend
RESEND_API_KEY=re_xxx
MOD_EMAILS=mod1@example.com,mod2@example.com
SENDER_EMAIL=noreply@yourdomain.com
# Admin email to receive book access requests (with Allow/Deny links)
ADMIN_EMAIL=bioarchive007@gmail.com

# Admin
ADMIN_DELETE_TOKEN=your_secret_admin_delete_token_here
